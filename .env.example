# Database
DATABASE_URL="postgresql://order_system:order_system@localhost:5432/order_system?schema=public"

# Redis — lock de estoque (RedisService) + cache read-through (CacheService)
REDIS_URL="redis://localhost:6379"

# RabbitMQ — filas assíncronas (reservation.expiry, email.send, order.confirmed)
# Management UI: http://localhost:15672
RABBITMQ_URL="amqp://order_system:order_system@localhost:5672"

# JWT (custom implementation)
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# TTL da reserva no banco (segundos). Expiração real via sweeper em GET /reservations.
# RabbitMQ tenta expirar assincronamente, mas o sweeper é o fallback confiável.
RESERVATION_TTL_SECONDS=900

# API
API_PORT=3001
API_URL="http://localhost:3001"

# Web
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"

# MinIO (object storage — product images)
MINIO_ENDPOINT="http://localhost:9000"
MINIO_PUBLIC_URL="http://localhost:9000"
NEXT_PUBLIC_MINIO_PUBLIC_URL="http://localhost:9000"
MINIO_ROOT_USER="order_system"
MINIO_ROOT_PASSWORD="order_system"

# SMTP (MailHog local)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="noreply@order-system.local"
