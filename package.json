{
  "name": "order-system-design",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=api --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "dev:web": "turbo run dev --filter=web",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "check-types": "turbo run check-types",
    "docker:dev:up": "docker compose -f docker-compose.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.yml down",
    "docker:up": "pnpm docker:dev:up",
    "docker:down": "pnpm docker:dev:down",
    "docker:prod:build": "docker compose -f docker-compose.prod.yml build",
    "docker:prod:up": "test -f .env.prod || cp .env.prod.example .env.prod; docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose -f docker-compose.prod.yml logs -f api web",
    "docker:prod:reset": "docker compose -f docker-compose.prod.yml down -v && pnpm docker:prod:up",
    "minio:setup": "bash scripts/minio-setup.sh",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:migrate": "pnpm --filter @repo/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @repo/database db:migrate:deploy",
    "db:push": "pnpm --filter @repo/database db:push",
    "db:seed": "pnpm --filter @repo/database db:seed",
    "db:setup": "pnpm db:migrate:deploy && pnpm db:seed",
    "dev:setup": "pnpm docker:dev:up && pnpm minio:setup && pnpm db:setup",
    "db:reset": "pnpm --filter @repo/database db:reset",
    "db:studio": "pnpm --filter @repo/database db:studio"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
