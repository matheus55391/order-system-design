# Copie para .env.prod: cp .env.prod.example .env.prod
# Stack prod simulada (order-system-prod). Pare o dev antes: pnpm docker:dev:down

# --- URLs vistas pelo browser (host) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_MINIO_PUBLIC_URL=http://localhost:9000
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# --- Serviços internos (rede Docker) ---
DATABASE_URL=postgresql://order_system:order_system@postgres:5432/order_system?schema=public
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://order_system:order_system@rabbitmq:5672
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
SMTP_HOST=mailhog
SMTP_PORT=1025

# --- App ---
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
RESERVATION_TTL_SECONDS=900
API_PORT=3001
MINIO_ROOT_USER=order_system
MINIO_ROOT_PASSWORD=order_system
SMTP_FROM=noreply@order-system.local
