generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  BUYER
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  CANCELED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELED
  EXPIRED
}

enum StockMovementType {
  RESERVE
  RELEASE
  SALE
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]
  productPrices      TenantProductPrice[]
  orders             Order[]
  reservations       Reservation[]
  stockMoves         StockMovement[]
  sellerCarts        Cart[]          @relation("CartSellerTenant")
  cartItemPrices     CartItem[]      @relation("CartItemPriceTenant")
  reservationPrices  Reservation[]   @relation("ReservationPriceTenant")
  orderItemPrices    OrderItem[]     @relation("OrderItemPriceTenant")
  stockMovePrices    StockMovement[] @relation("StockMovementPriceTenant")

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         UserRole @default(BUYER)
  tenantId     String   @map("tenant_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  carts               Cart[]
  reservations        Reservation[]
  orders              Order[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  stockMoves          StockMovement[]

  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  imageUrl    String?  @map("image_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  variants ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  sku       String   @unique
  size      String?
  color     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    Inventory?
  tenantPrices TenantProductPrice[]
  cartItems    CartItem[]
  reservations Reservation[]
  orderItems   OrderItem[]
  stockMoves   StockMovement[]

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id            String   @id @default(uuid())
  variantId     String   @unique @map("variant_id")
  totalStock    Int      @map("total_stock")
  reservedStock Int      @default(0) @map("reserved_stock")
  updatedAt     DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventories")
}

model TenantProductPrice {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  variantId String   @map("variant_id")
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, variantId])
  @@map("tenant_product_prices")
}

model Cart {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  tenantId      String   @map("tenant_id")
  priceTenantId String   @map("price_tenant_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceTenant Tenant     @relation("CartSellerTenant", fields: [priceTenantId], references: [id])
  items       CartItem[]

  @@unique([userId, priceTenantId])
  @@index([tenantId])
  @@map("carts")
}

model CartItem {
  id            String   @id @default(uuid())
  cartId        String   @map("cart_id")
  variantId     String   @map("variant_id")
  quantity      Int
  priceTenantId String   @map("price_tenant_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cart        Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  priceTenant Tenant         @relation("CartItemPriceTenant", fields: [priceTenantId], references: [id])

  @@unique([cartId, variantId, priceTenantId])
  @@map("cart_items")
}

model Reservation {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  userId        String            @map("user_id")
  variantId     String            @map("variant_id")
  quantity      Int
  priceTenantId String            @map("price_tenant_id")
  status        ReservationStatus @default(ACTIVE)
  expiresAt     DateTime          @map("expires_at")
  orderId       String?           @map("order_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  user        User           @relation(fields: [userId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  priceTenant Tenant         @relation("ReservationPriceTenant", fields: [priceTenantId], references: [id])
  stockMoves  StockMovement[]

  @@index([tenantId, status])
  @@index([status, expiresAt])
  @@index([userId, status])
  @@map("reservations")
}

model Order {
  id        String      @id @default(uuid())
  tenantId  String      @map("tenant_id")
  userId    String      @map("user_id")
  status    OrderStatus @default(CONFIRMED)
  total     Decimal     @db.Decimal(10, 2)
  createdAt DateTime    @default(now()) @map("created_at")

  tenant     Tenant          @relation(fields: [tenantId], references: [id])
  user       User            @relation(fields: [userId], references: [id])
  items      OrderItem[]
  stockMoves StockMovement[]

  @@index([tenantId, status])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String  @map("order_id")
  variantId     String  @map("variant_id")
  quantity      Int
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)
  priceTenantId String  @map("price_tenant_id")

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  priceTenant Tenant         @relation("OrderItemPriceTenant", fields: [priceTenantId], references: [id])

  @@map("order_items")
}

model StockMovement {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  variantId     String            @map("variant_id")
  userId        String?           @map("user_id")
  type          StockMovementType
  quantity      Int
  reservationId String?           @map("reservation_id")
  orderId       String?           @map("order_id")
  priceTenantId String?           @map("price_tenant_id")
  createdAt     DateTime          @default(now()) @map("created_at")

  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  variant     ProductVariant  @relation(fields: [variantId], references: [id])
  user        User?           @relation(fields: [userId], references: [id])
  reservation Reservation?    @relation(fields: [reservationId], references: [id])
  order       Order?          @relation(fields: [orderId], references: [id])
  priceTenant Tenant?         @relation("StockMovementPriceTenant", fields: [priceTenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([variantId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}
